# .env: secrets for your fleet. `./fleet setup` fills this in.
# Never commit this file.
#
# There are no AI API keys here on purpose. Models run on your Claude and
# ChatGPT subscriptions, connected with `./fleet login claude` and
# `./fleet login chatgpt`; those logins live in the container volumes.

# ── Generated by ./fleet setup ───────────────────────────────────────────────
# Protects the OpenClaw Control UI and gateway API.
OPENCLAW_GATEWAY_TOKEN=
# Password for the Hermes dashboard (user: admin).
HERMES_DASHBOARD_PASSWORD=
# Postgres password for engram's database.
POSTGRES_PASSWORD=

# ── Who is allowed to talk to your agents ───────────────────────────────────
# Agents only answer these people in DMs; anyone else gets a pairing code you
# approve with `./fleet pair`.
OWNER_DISCORD_ID=
OWNER_TELEGRAM_ID=
# Phone number with country code, digits only (e.g. 447700900123).
OWNER_WHATSAPP_NUMBER=

# ── Chat bots: one per agent, named after the agent id in fleet.yaml ────────
# Discord: https://discord.com/developers/applications → New Application → Bot
#          → Reset Token. Turn on "Message Content Intent".
# Telegram: message @BotFather → /newbot.
DISCORD_TOKEN_OPS=
DISCORD_TOKEN_BUILDER=
TELEGRAM_TOKEN_ASSISTANT=

# ── session-warden alerts (optional) ────────────────────────────────────────
# A Telegram bot + chat that receives fleet health alerts.
WARDEN_TELEGRAM_BOT_TOKEN=
WARDEN_TELEGRAM_CHAT_ID=

# ── Advanced ────────────────────────────────────────────────────────────────
# Image tag to run. Pin a release (e.g. 0.1.0) in production.
FLEETKIT_VERSION=latest
# Host ports. Bound to 127.0.0.1 only; reach them over SSH or a tunnel.
OPENCLAW_PORT=18789
HERMES_DASHBOARD_PORT=9119
FLEET_BOARD_PORT=8090
ENGRAM_PORT=8080
